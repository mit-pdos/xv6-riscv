@test(5, "memdump, formats h c, bounds checking, usage")
def test_memdump_corner():
    r.run_qemu(shell_script([
        'echo abcdefgh | memdump h',   # in bounds: "ab" -> 0x6261 == 25185
        'echo abcdefgh | memdump c',   # in bounds: char 'a'
        'echo a | memdump i',          # only 2 bytes ("a\n") for a 4-byte int -> refuse
        'echo abc | memdump ii',       # first int fits ("abc\n"); second runs off the end
        'memdump a b c',               # too many args -> usage
    ]))
    r.match('^25185$', '^a$', '^174285409$',
            'memdump: not enough data',  # bounds check fires for the truncated reads
            '^Usage: memdump',
            # A correct, bounds-checked memdump must NOT zero-pad past the input:
            # 2657 == 0x00000a61 is the "a\n\0\0" value a padding bug would print.
            no=['^2657$'])

@test(10, "find, missing target, no duplicates, directory match")
def test_find_corner():
    present = random_str()
    absent = random_str()
    dname = random_str()
    r.run_qemu(shell_script([
        'mkdir d1',
        'echo > d1/%s' % present,
        'mkdir d2',
        'mkdir d2/%s' % dname,
        'find . %s' % present,   # one match, exactly once
        'find . %s' % absent,    # no match, no crash
        'find . %s' % dname,     # matches a directory name
        'echo DONE',
    ]))
    # Catch a solution that recurses into "." / "..": that would print the
    # file many times (or "path too long") instead of exactly once.
    found = re.findall(r'(?m)^\./.*%s' % present, r.qemu.output)
    assert_equal(len(found), 1, "times %s reported by find" % present)
    # Missing target produces no result line.
    missing = re.findall(r'(?m)^\./.*%s' % absent, r.qemu.output)
    assert_equal(len(missing), 0, "times missing target reported")
    # A directory whose name matches is itself reported.
    dirmatch = re.findall(r'(?m)^\./.*%s' % dname, r.qemu.output)
    assert_equal(len(dirmatch), 1, "times directory %s reported" % dname)
    # The shell kept running (no hang / panic).
    r.match('^DONE$', no=['path too long', 'panic'])

