@test(5, "sixfive, stdin and missing file")
def test_sixfive_corner():
    missing = random_str()
    r.run_qemu(shell_script([
        # no file args -> read numbers from standard input
        'echo 12 30 7 | sixfive',
        # a file that does not exist -> error message, no crash
        'sixfive %s' % missing,
